# --- AI provider (set ONE; without either the app runs in free demo mode) ---
# Free option: Google Gemini. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-flash-lite-latest, which has the largest free quota)
GEMINI_MODEL=
# Paid option (highest quality): Claude. Get a key at https://console.anthropic.com/  (used if set)
ANTHROPIC_API_KEY=

# --- Auth.js ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app: https://github.com/settings/developers  (callback: <site>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client (optional): https://console.cloud.google.com/apis/credentials  (callback: <site>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database ---
# Neon Postgres connection string. Leave empty locally to use the embedded database in ./.pglite
DATABASE_URL=

# --- Optional ---
# Public site URL, used for share-link previews
NEXT_PUBLIC_SITE_URL=
# AI interviews each signed-in user may start per 24 hours (default 5)
DAILY_INTERVIEW_LIMIT=
