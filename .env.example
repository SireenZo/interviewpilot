# --- AI (optional locally: without it the app runs in free demo mode) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Auth.js ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app: https://github.com/settings/developers  (callback: <site>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client (optional): https://console.cloud.google.com/apis/credentials  (callback: <site>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database ---
# Neon Postgres connection string. Leave empty locally to use the embedded database in ./.pglite
DATABASE_URL=

# --- Optional ---
# Public site URL, used for share-link previews
NEXT_PUBLIC_SITE_URL=
# AI interviews each signed-in user may start per 24 hours (default 5)
DAILY_INTERVIEW_LIMIT=
